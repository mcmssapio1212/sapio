local alive = true
local auto = false
local selectedHighlight = nil
local scanBusy = false
local minValues = {0, 1000000000, 5000000000, 10000000000, 20000000000, 50000000000}
local minLabels = {"0/s", "1B/s", "5B/s", "10B/s", "20B/s", "50B/s"}
local minIndex = 1
local rarities = {"Any", "Divine", "Eternal", "Secret", "Mythic", "Legendary", "Rare"}
local rarityIndex = 1

local function cleanHighlight()
    if selectedHighlight then
        selectedHighlight:Destroy()
        selectedHighlight = nil
    end
end

local function lower(value)
    return string.lower(tostring(value or ""))
end

local function hasHint(value)
    local text = lower(value)
    return text:find("egg", 1, true)
        or text:find("ovo", 1, true)
        or text:find("hatch", 1, true)
        or text:find("jellyfish", 1, true)
        or text:find("shark", 1, true)
        or text:find("centaur", 1, true)
        or text:find("gargoyle", 1, true)
        or text:find("gorillastein", 1, true)
        or text:find("voidseer", 1, true)
        or text:find("pumpkin", 1, true)
end

local multipliers = {k=1e3, m=1e6, b=1e9, t=1e12, qa=1e15, qi=1e18}

local function readRate(source)
    local text = lower(source)
    local amount, suffix = text:match("%$%s*([%d.,]+)%s*(qi)%s*/s")
    if not amount then amount, suffix = text:match("%$%s*([%d.,]+)%s*(qa)%s*/s") end
    if not amount then amount, suffix = text:match("%$%s*([%d.,]+)%s*([kmbt])%s*/s") end
    if not amount or not multipliers[suffix] then return nil end
    local normalized = amount:gsub(",", ".")
    local numeric = tonumber(normalized)
    if not numeric then return nil end
    return numeric * multipliers[suffix]
end

local function readRarity(source)
    local text = lower(source)
    for _, name in ipairs({"Divine", "Eternal", "Secret", "Mythic", "Legendary", "Rare"}) do
        if text:find(lower(name), 1, true) then return name end
    end
    return nil
end

local function rateLabel(value)
    if not value then return "Valor não identificado" end
    if value >= 1e18 then return string.format("$%.2fQi/s", value / 1e18) end
    if value >= 1e15 then return string.format("$%.2fQa/s", value / 1e15) end
    if value >= 1e12 then return string.format("$%.2fT/s", value / 1e12) end
    if value >= 1e9 then return string.format("$%.2fB/s", value / 1e9) end
    if value >= 1e6 then return string.format("$%.2fM/s", value / 1e6) end
    return string.format("$%.0f/s", value)
end

local function looksLikeValue(value)
    local text = lower(value)
    return text:find("/s", 1, true)
        or text:find("moneypersecond", 1, true)
        or text:find("cashpersecond", 1, true)
        or text:find("income", 1, true)
        or text:find("rarity", 1, true)
end

local function objectForHighlight(instance)
    if instance:IsA("Model") or instance:IsA("BasePart") then
        return instance
    end
    local model = instance:FindFirstAncestorOfClass("Model")
    if model and model:IsDescendantOf(Workspace) then
        return model
    end
    local part = instance:FindFirstAncestorWhichIsA("BasePart")
    if part and part:IsDescendantOf(Workspace) then
        return part
    end
    return nil
end

local function distanceTo(instance)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local success, pivot = pcall(function()
        if instance:IsA("Model") then return instance:GetPivot().Position end
        if instance:IsA("BasePart") then return instance.Position end
    end)
    if success and pivot then
        return (root.Position - pivot).Magnitude
    end
    return nil
end

local function scan()
    if scanBusy or not alive then return end
    scanBusy = true
    status.Text = "Varrendo objetos visiveis ao cliente..."

    local candidates = {}
    local checked = 0
    local function record(instance, reason, weight, nameHint, numericValue)
        local target = objectForHighlight(instance)
        if not target or not target.Parent then return end
        local candidate = candidates[target]
        if not candidate then
            candidate = {target = target, score = 0, descriptions = {},
                         displayName = target.Name, rate = nil, rarity = nil}
            candidates[target] = candidate
        end
        candidate.score = candidate.score + weight
        if nameHint and #nameHint >= 3 and #nameHint <= 45 then
            candidate.displayName = nameHint
        end
        local parsedRate = readRate(reason)
        if parsedRate and (not candidate.rate or parsedRate > candidate.rate) then
            candidate.rate = parsedRate
        end
        if type(numericValue) == "number" and numericValue > 0 then
            candidate.rate = numericValue
        end
        candidate.rarity = readRarity(reason) or candidate.rarity
        if #candidate.descriptions < 3 then
            table.insert(candidate.descriptions, tostring(reason):sub(1, 75))
        end
    end

    local descendants = Workspace:GetDescendants()
    for _, inst in ipairs(descendants) do
        checked = checked + 1
        if checked > MAX_SCAN then break end
        if (inst:IsA("Model") or inst:IsA("BasePart")) and hasHint(inst.Name) then
            record(inst, "Nome: " .. inst.Name, 4)
        end
        if inst:IsA("ProximityPrompt") then
            local text = tostring(inst.ObjectText) .. " " .. tostring(inst.ActionText)
            if hasHint(text) then record(inst, "Interacao: " .. text, 6) end
        elseif inst:IsA("TextLabel") or inst:IsA("TextButton") then
            local text = tostring(inst.Text)
            if hasHint(text) or looksLikeValue(text) then
                record(inst, "Texto: " .. text, 3)
            end
        elseif inst:IsA("BillboardGui") then
            local strings = {}
            for _, label in ipairs(inst:GetDescendants()) do
                if label:IsA("TextLabel") and #strings < 8 then
                    table.insert(strings, tostring(label.Text))
                end
            end
            local merged = table.concat(strings, " | ")
            if hasHint(merged) or readRate(merged) then
                local hint = nil
                for _, line in ipairs(strings) do
                    local clean = line:match("^%s*(.-)%s*$")
                    if clean and #clean >= 3 and #clean <= 45
                        and not clean:find("%$") and not readRarity(clean) then
                        hint = clean
                        break
                    end
                end
                record(inst, "Etiqueta: " .. merged, 8, hint)
            end
        end
        if inst:IsA("Model") or inst:IsA("BasePart") then
            local attrs = inst:GetAttributes()
            for key, value in pairs(attrs) do
                if hasHint(key) or looksLikeValue(key)
                    or (hasHint(value) and type(value) == "string") then
                    local numeric = nil
                    if type(value) == "number" and looksLikeValue(key) then
                        numeric = value
                    end
                    record(inst, key .. "=" .. tostring(value), 2, nil, numeric)
                end
            end
        end
        if checked % 650 == 0 then task.wait() end
    end

    local results = {}
    local totalCandidates = 0
    for _, value in pairs(candidates) do
        totalCandidates = totalCandidates + 1
        value.distance = distanceTo(value.target)
        local enough = minValues[minIndex] == 0
            or (value.rate and value.rate >= minValues[minIndex])
        local rarityOk = rarities[rarityIndex] == "Any"
            or value.rarity == rarities[rarityIndex]
        if enough and rarityOk then
            table.insert(results, value)
        end
    end
    table.sort(results, function(a, b)
        if a.score ~= b.score then return a.score > b.score end
        return (a.distance or math.huge) < (b.distance or math.huge)
    end)

    for _, child in ipairs(list:GetChildren()) do
        if child.Name == "CastroResultRow" then child:Destroy() end
    end
    for index = 1, math.min(#results, MAX_RESULTS) do
        local result = results[index]
        local target = result.target
        local distance = result.distance and string.format(" | %.0fm", result.distance) or ""
        local display = result.displayName
        local row = make("Frame", list, {
            Name = "CastroResultRow",
            Size = UDim2.new(1, -8, 0, 57),
            BackgroundColor3 = Color3.fromRGB(43, 45, 53),
            BorderSizePixel = 0,
            LayoutOrder = index
        })
        make("UICorner", row, {CornerRadius = UDim.new(0, 5)})
        make("TextLabel", row, {
            Size = UDim2.new(1, -105, 0, 24),
            Position = UDim2.fromOffset(8, 4),
            BackgroundTransparency = 1,
            Text = display,
            Font = Enum.Font.GothamBold,
            TextColor3 = COLOR_TEXT,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd
        })
        make("TextLabel", row, {
            Size = UDim2.new(1, -105, 0, 23),
            Position = UDim2.fromOffset(8, 29),
            BackgroundTransparency = 1,
            Text = (result.rarity or "Raridade ?") .. "  " ..
                rateLabel(result.rate) .. distance,
            Font = Enum.Font.GothamBold,
            TextColor3 = result.rate and COLOR_GREEN or COLOR_SUB,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd
        })
        local mark = button(row, "MARCAR", 334, 9, 87, 38, function()
            cleanHighlight()
            if target and target.Parent then
                local h = Instance.new("Highlight")
                h.Name = "CastroFinderLocalHighlight"
                h.Adornee = target
                h.DepthMode = Enum.HighlightDepthMode.Occluded
                h.FillColor = COLOR_ORANGE
                h.OutlineColor = Color3.fromRGB(255, 255, 255)
                h.FillTransparency = 0.65
                h.Parent = Workspace
                selectedHighlight = h
                status.Text = "Candidato selecionado: " .. target.Name
            end
        end)
        mark.BackgroundColor3 = COLOR_ORANGE
        mark.TextColor3 = Color3.fromRGB(16, 19, 26)
    end
    status.Text = string.format(
        "%d de %d candidatos; %d objetos lidos. Dados nao confirmados.",
        #results, totalCandidates, math.min(checked, MAX_SCAN)
    )
    scanBusy = false
end

